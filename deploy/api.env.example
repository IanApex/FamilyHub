# Server-side secrets for the API container.
#
# Copy to /opt/familyhub/.env on the VPS, fill in, then `chmod 600 .env`.
# Never commit the filled-in version.
#
# Generate the two keys on the server:
#   JWT_SECRET:           openssl rand -base64 48
#   TOKEN_ENCRYPTION_KEY: openssl rand -base64 32   # must decode to exactly 32 bytes
#
# Keep JWT_SECRET stable: changing it invalidates every existing login.

# --- Database (Neon) ---------------------------------------------------------
# sslmode=require is mandatory for Neon.
DB_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# --- Secrets ----------------------------------------------------------------
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# --- Origins ----------------------------------------------------------------
# Comma-separated. Same-origin nginx setups still need this set or the app
# refuses to start (application-prod.yml has no default).
CORS_ALLOWED_ORIGINS=https://familyhub.example.com

# --- Google Calendar sync (optional) ----------------------------------------
# Redirect URIs must be registered in the Google Cloud console.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://familyhub.example.com/api/google/callback
# GOOGLE_FRONTEND_REDIRECT=https://familyhub.example.com/settings?googleConnected=true
