# Local deploy targets. Copy to deploy/deploy.env and fill in.
# deploy/deploy.env is gitignored — it names your server, not secrets, but
# there is no reason to publish it.

# SSH target for the VPS.
SERVER=root@your-vps-host

# Public origin, used for the post-deploy health check.
DOMAIN=familyhub.example.com

# Where nginx serves the frontend from (must match `root` in nginx/familyhub.conf).
FE_REMOTE_PATH=/var/www/familyhub

# Where docker-compose.prod.yml and .env live on the server.
COMPOSE_DIR=/opt/familyhub

# Source of the backend image tags.
API_REPO=joe-bor/family-hub-api

# Pin a backend version, or leave unset to resolve the latest GitHub Release.
# BE_IMAGE_TAG=1.9.0
