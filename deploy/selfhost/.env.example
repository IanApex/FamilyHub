# Copy to deploy/selfhost/.env and fill in. That file is gitignored — it holds
# real secrets, so never commit it.
#
# Generate the two keys (PowerShell, no extra tools needed):
#   $b=New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   $b=New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#
# Keep JWT_SECRET stable forever: changing it signs everyone out of every device.

# --- Database (Neon) --------------------------------------------------------
# Neon shows a URL like postgresql://user:pass@ep-xyz.aws.neon.tech/dbname
# Split it up: host+database go in DB_URL, credentials go below.
# sslmode=require is mandatory for Neon.
DB_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# --- Secrets ----------------------------------------------------------------
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# --- Origins ----------------------------------------------------------------
# Your Tailscale Funnel URL, shown by `tailscale funnel --bg 8081`.
# Looks like https://<machine-name>.<tailnet-name>.ts.net
# Required even on a same-origin setup: the prod profile has no default and the
# app refuses to start without it.
CORS_ALLOWED_ORIGINS=https://your-pc.your-tailnet.ts.net

# --- Backend version --------------------------------------------------------
# Pin the API image. Bump this to upgrade.
BE_IMAGE_TAG=1.9.0

# --- Google Calendar sync (optional) ----------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-pc.your-tailnet.ts.net/api/google/callback
# GOOGLE_FRONTEND_REDIRECT=https://your-pc.your-tailnet.ts.net/settings?googleConnected=true
